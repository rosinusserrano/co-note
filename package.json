{
  "name": "pennable-web-notes",
  "version": "0.0.1",
  "description": "Web-based, tablet-installable notes app with pen drawing and independent per-session zoom/scroll.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync": "node server/sync-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.5.28",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/ws": "^8.18.1",
    "@vite-pwa/sveltekit": "^0.6.6",
    "lib0": "^0.2.117",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.8",
    "ws": "^8.21.0",
    "y-protocols": "^1.0.7"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.3",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  }
